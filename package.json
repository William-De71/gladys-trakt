{
  "name": "gladys-trakt",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Trakt: the episodes and movie releases of your Trakt account in the Gladys calendar, what you are watching, scene triggers and actions (watchlist, mark as watched) and dashboard widgets with posters.",
  "homepage": "https://github.com/William-De71/gladys-trakt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-trakt.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "trakt",
    "tv-shows",
    "movies",
    "watchlist",
    "home-automation"
  ]
}
